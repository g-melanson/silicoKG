---
config:
  themeVariables:
    titleColor: "#000000"
    clusterBorder: "#000000"
---
flowchart TB
  subgraph schemas [Schemas]
    direction TB
    src_schema[source schema yaml]
    xform_schema[transform yaml]
    integrate_priorities[integrate priorities yaml]
    classify_rules[classification rules yaml]
    domain_schema[domain schema yaml]
  end

  subgraph pipeline [ ]
    direction LR

    subgraph sources [Sources in run config]
      direction TB
      src1[ncbi-gene-info]
      src2[uniprot-gaf]
      src3[corum-human-complexes]
    end

    subgraph per_source [Per source]
      direction TB
      ingest[Ingest]
      validate[Validate]
      transform[Transform]
    end

    subgraph per_run [Once per run_id]
      direction TB
      integrate[Integrate]
      classify[Classify]
      publish[Publish]
      export[Export Neo4j]
    end

    subgraph tiers [Universe tiers]
      direction TB
      staging[1-staging]
      bronze[2-bronze]
      silver[3-silver]
      merged[4-merged]
      gold[5-gold]
      quarantine[[quarantine]]
      staging --> bronze --> silver --> merged --> gold
    end

    subgraph neo4j [Neo4j optional]
      direction TB
      load[Load DB]
    end

    sources --> per_source --> per_run
    per_run ~~~ tiers
    export --> load

    ingest --> staging
    validate --> bronze
    transform --> silver
    integrate --> merged
    classify --> merged
    publish --> gold
    export --> gold

    bronze -.-> quarantine
    silver -.-> quarantine
    merged -.-> quarantine
    gold -.-> quarantine
  end

  src_schema --> ingest
  src_schema --> validate
  xform_schema --> transform
  integrate_priorities --> integrate
  classify_rules --> classify
  domain_schema --> publish

  style pipeline fill:transparent,stroke:transparent,color:transparent
  style schemas fill:#fff9c4,stroke:#000000,color:#000000
  style src_schema fill:#fce4ec,stroke:#f48fb1,color:#880e4f
  style xform_schema fill:#fce4ec,stroke:#f48fb1,color:#880e4f
  style integrate_priorities fill:#fce4ec,stroke:#f48fb1,color:#880e4f
  style classify_rules fill:#fce4ec,stroke:#f48fb1,color:#880e4f
  style domain_schema fill:#fce4ec,stroke:#f48fb1,color:#880e4f
  style src1 fill:#f5f5f5,stroke:#757575,color:#424242
  style src2 fill:#f5f5f5,stroke:#757575,color:#424242
  style src3 fill:#f5f5f5,stroke:#757575,color:#424242
  style ingest fill:#bbdefb,stroke:#1976d2,color:#0d47a1
  style validate fill:#bbdefb,stroke:#1976d2,color:#0d47a1
  style transform fill:#bbdefb,stroke:#1976d2,color:#0d47a1
  style staging fill:#e1bee7,stroke:#7b1fa2,color:#4a148c
  style bronze fill:#e1bee7,stroke:#7b1fa2,color:#4a148c
  style silver fill:#e1bee7,stroke:#7b1fa2,color:#4a148c
  style merged fill:#e1bee7,stroke:#7b1fa2,color:#4a148c
  style gold fill:#e1bee7,stroke:#7b1fa2,color:#4a148c
